{
  "name": "pi-antigravity-auth",
  "version": "0.1.0",
  "description": "Pi Coding Agent provider extension for Google Antigravity and Gemini CLI OAuth quotas with account rotation.",
  "type": "module",
  "license": "MIT",
  "author": "Joel Manuel <joeljmanuel@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WindowsRefundDay/pi-antigravity-auth.git"
  },
  "bugs": {
    "url": "https://github.com/WindowsRefundDay/pi-antigravity-auth/issues"
  },
  "homepage": "https://github.com/WindowsRefundDay/pi-antigravity-auth#readme",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "antigravity",
    "gemini",
    "claude",
    "oauth",
    "google",
    "provider"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "extensions/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:list-models": "PI_SKIP_VERSION_CHECK=1 pi --no-extensions -e . --list-models antigravity",
    "test:smoke": "PI_SKIP_VERSION_CHECK=1 pi --no-extensions -e . --provider antigravity --model gemini-3.1-pro-low --no-builtin-tools -p 'Say ok in one word'",
    "proxy": "npx esbuild extensions/antigravity-auth/proxy.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/proxy.js --external:proper-lockfile && node dist/proxy.js"
  },
  "dependencies": {
    "opencode-antigravity-auth": "^1.6.5-beta.0",
    "proper-lockfile": "^4.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
